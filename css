
:root {
  --bg: #090909;
  --surface: #111111;
  --surface-hover: #191011;
  --red: #e11d36;
  --red-bright: #ff334b;
  --text: #f5f1f1;
  --muted: #a39a9b;
  --border: rgba(225, 29, 54, 0.23);
  --serif: "Playfair Display", Georgia, serif;
  --sans: "DM Sans", Arial, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  line-height: 1.7;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.ambient {
  position: fixed;
  width: 400px;
  height: 400px;
  border-radius: 50%;
  background: rgba(180, 0, 30, 0.08);
  filter: blur(110px);
  pointer-events: none;
  z-index: -1;
  animation: breathe 8s ease-in-out infinite alternate;
}

.ambient-one {
  top: 5%;
  left: -220px;
}

.ambient-two {
  top: 55%;
  right: -250px;
  animation-delay: -4s;
}

.navbar {
  min-height: 76px;
  padding: 18px 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  border-bottom: 1px solid var(--border);
  background: rgba(9, 9, 9, 0.88);
  backdrop-filter: blur(16px);
  position: sticky;
  top: 0;
  z-index: 10;
}

.logo {
  font-size: 11px;
  letter-spacing: 2px;
  font-weight: 700;
}

.logo span,
.nav-heart,
.section-heading h2 span,
.closing-heart,
footer span {
  color: var(--red-bright);
}

.navbar nav {
  display: flex;
  gap: 30px;
}

.navbar nav a {
  font-size: 12px;
  color: var(--muted);
  transition: color 0.25s;
}

.navbar nav a:hover {
  color: var(--red-bright);
}

.nav-heart {
  font-size: 25px;
}

.hero {
  min-height: 680px;
  padding: 110px 24px 100px;
  display: grid;
  place-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.hero-content {
  max-width: 700px;
  position: relative;
  z-index: 1;
}

.eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 3px;
  color: var(--red-bright);
}

.hero h1 {
  font-family: var(--serif);
  font-size: clamp(58px, 10vw, 100px);
  line-height: 1.08;
  font-weight: 400;
  margin: 28px 0;
  letter-spacing: -3px;
}

.hero h1 em,
.closing h2 em {
  color: var(--red-bright);
  font-weight: 400;
}

.hero-description {
  color: #bcb4b5;
  font-size: 14px;
  max-width: 450px;
  margin: 0 auto 32px;
}

.button {
  display: inline-flex;
  align-items: center;
  gap: 25px;
  padding: 13px 23px;
  border: 1px solid var(--red);
  border-radius: 4px;
  font-size: 12px;
  transition: background 0.3s, box-shadow 0.3s,
    transform 0.3s;
}

.button span {
  color: var(--red-bright);
  font-size: 18px;
  transition: transform 0.3s;
}

.button:hover {
  background: rgba(225, 29, 54, 0.12);
  box-shadow: 0 0 30px rgba(225, 29, 54, 0.15);
  transform: translateY(-3px);
}

.button:hover span {
  transform: translateX(4px);
}

.signature {
  margin-top: 38px;
  color: var(--muted);
  font-family: var(--serif);
  font-style: italic;
  font-size: 13px;
}

.hero-glow {
  position: absolute;
  width: 450px;
  height: 150px;
  bottom: -100px;
  left: calc(50% - 225px);
  background: var(--red);
  opacity: 0.13;
  filter: blur(90px);
}

.section {
  max-width: 1150px;
  margin: auto;
  padding: 85px 28px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 35px;
}

.section-heading h2 {
  font: 400 clamp(34px, 5vw, 48px) var(--serif);
  margin: 10px 0;
}

.muted {
  color: var(--muted);
  font-size: 13px;
}

.counter {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 1px;
  white-space: nowrap;
}

.letter-grid,
.memory-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.letter-card {
  min-height: 265px;
  padding: 26px;
  border: 1px solid var(--border);
  background: linear-gradient(145deg, #141112, #0b0b0b 75%);
  color: var(--text);
  text-align: left;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  border-radius: 5px;
  transition: border-color 0.3s, transform 0.3s,
    background 0.3s, box-shadow 0.3s;
}

.letter-card:hover {
  border-color: var(--red);
  background: var(--surface-hover);
  transform: translateY(-6px);
  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.3);
}

.card-icon {
  color: var(--red-bright);
  font-size: 27px;
  margin-bottom: 20px;
}

.card-number {
  font-size: 9px;
  letter-spacing: 2px;
  color: var(--red-bright);
}

.card-title {
  font: 21px var(--serif);
  margin: 10px 0;
}

.card-description {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.8;
}

.card-footer {
  margin-top: auto;
  padding-top: 22px;
  width: 100%;
  display: flex;
  justify-content: space-between;
  font-size: 9px;
  letter-spacing: 1.5px;
}

.card-footer span {
  color: var(--red-bright);
}

.memory-card {
  border: 1px solid var(--border);
  border-radius: 5px;
  overflow: hidden;
  background: var(--surface);
  transition: transform 0.3s;
}

.memory-card:hover {
  transform: translateY(-4px);
}

.memory-placeholder {
  min-height: 180px;
  display: grid;
  place-items: center;
  font: 50px var(--serif);
  color: rgba(255, 255, 255, 0.3);
  background:
    radial-gradient(ellipse at 50% 100%,
      rgba(225, 29, 54, 0.3), transparent 65%),
    linear-gradient(140deg, #201014, #101010);
}

.memory-card h3 {
  font: 19px var(--serif);
  padding: 18px 18px 4px;
}

.memory-card p {
  padding: 0 18px 20px;
  color: var(--muted);
  font-size: 12px;
}

.closing {
  text-align: center;
  padding: 100px 24px 115px;
}

.closing-heart {
  display: block;
  font-size: 28px;
  animation: heartbeat 1.8s ease-in-out infinite;
  margin-bottom: 25px;
}

.closing h2 {
  font: 400 clamp(35px, 6vw, 57px) var(--serif);
  margin: 18px 0;
}

footer {
  padding: 25px;
  text-align: center;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 2px;
}

/* Letter modal */

.modal {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
  z-index: 30;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.modal.active {
  opacity: 1;
  visibility: visible;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(8px);
}

.letter-paper {
  position: relative;
  z-index: 1;
  background: #151011;
  border: 1px solid rgba(225, 29, 54, 0.5);
  border-radius: 7px;
  width: min(100%, 580px);
  max-height: 85vh;
  overflow-y: auto;
  padding: clamp(25px, 6vw, 50px);
  box-shadow: 0 0 80px rgba(225, 29, 54, 0.1);
  transform: translateY(20px) scale(0.98);
  transition: transform 0.35s;
}

.modal.active .letter-paper {
  transform: translateY(0) scale(1);
}

.close-button {
  position: absolute;
  top: 12px;
  right: 18px;
  border: 0;
  background: transparent;
  color: var(--muted);
  font-size: 30px;
  cursor: pointer;
}

.close-button:hover {
  color: var(--red-bright);
}

.letter-paper h2 {
  font: 32px var(--serif);
  margin: 18px 0;
}

.letter-body {
  white-space: pre-line;
  color: #d5cccd;
  font-size: 14px;
  line-height: 2;
}

.letter-signature {
  font: italic 19px var(--serif);
  margin-top: 28px;
}

.letter-signature span {
  color: var(--red-bright);
}

body.modal-open {
  overflow: hidden;
}

/* Scroll reveals */

.reveal {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes breathe {
  from { transform: scale(0.9); opacity: 0.6; }
  to { transform: scale(1.15); opacity: 1; }
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  15% { transform: scale(1.16); }
  30% { transform: scale(1); }
  45% { transform: scale(1.1); }
  60% { transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}

@media (max-width: 700px) {
  .navbar {
    padding: 16px 5%;
    flex-wrap: wrap;
  }

  .navbar nav {
    order: 3;
    width: 100%;
    justify-content: center;
    gap: 28px;
  }

  .hero {
    min-height: 590px;
    padding-top: 80px;
  }

  .hero h1 {
    letter-spacing: -2px;
  }

  .section {
    padding: 65px 20px;
  }

  .letter-grid,
  .memory-grid {
    grid-template-columns: 1fr;
  }

  .letter-card {
    min-height: 230px;
  }

  .memory-placeholder {
    min-height: 210px;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .closing {
    padding: 75px 20px;
  }
}
