                </div>

            </div>


            <div class="letter-options">

                <label>To</label>

                <select id="receiver">

                    <option value="Rachelle">
                        Rachelle
                    </option>

                    <option value="Kat">
                        Kat
                    </option>

                </select>


                <label>Choose Your Paper</label>

                <div
                    id="paperChoices"
                    class="paper-grid"
                ></div>

            </div>


            <div
                id="letterPaper"
                class="letter-paper paper-1"
            >

                <input
                    type="text"
                    id="letterTitle"
                    placeholder="Letter title..."
                >

                <div class="paper-divider"></div>

                <textarea
                    id="letterText"
                    placeholder="Write your letter here..."
                ></textarea>

                <div class="signature">

                    With love,

                    <strong id="signature">
                        Kat
                    </strong>

                </div>

            </div>


            <button
                class="red-button send-button"
                id="sendLetter"
            >
                SEND LETTER
            </button>

        </section>

    </main>

</div>


