<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>K&R</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<!-- ================= LOGIN ================= -->

<div id="loginPage" class="page active">

    <div class="login-box">

        <div class="logo">K<span>&</span>R</div>
        <div class="logo-subtitle">LOVE LETTERS</div>

        <form id="loginForm">

            <label>Account Name</label>
            <input
                type="text"
                id="username"
                placeholder="Enter account name"
                required
            >

            <label>Password</label>

            <div class="password-wrapper">
                <input
                    type="password"
                    id="password"
                    placeholder="Enter password"
                    required
                >

                <button type="button" id="togglePassword">
                    ◉
                </button>
            </div>

            <button class="red-button" type="submit">
                LOGIN
            </button>

            <button
                type="button"
                class="forgot"
                id="forgotButton"
            >
                Forgot Password?
            </button>

            <p id="loginMessage"></p>

        </form>

    </div>

</div>


<!-- ================= FORGOT PASSWORD ================= -->

<div id="forgotPage" class="page">

    <div class="login-box">

        <button class="back-button" id="backLogin">
            ← Back
        </button>

        <div class="small-logo">K&R</div>

        <h2>Reset Password</h2>

        <p class="description">
            Answer both questions to create a new password.
        </p>

        <label>Account</label>

        <select id="forgotAccount">
            <option value="">Choose account</option>
            <option value="Kat">Kat</option>
            <option value="Rachelle">Rachelle</option>
        </select>

        <label>What is the name of your dog?</label>

        <input
            type="text"
            id="dogAnswer"
            placeholder="Your answer"
        >

        <label>When is your anniversary?</label>

        <input
            type="text"
            id="anniversaryAnswer"
            placeholder="Example: July 17, 2026"
        >

        <label>New Password</label>

        <input
            type="password"
            id="newPassword"
            placeholder="New password"
        >

        <button
            class="red-button"
            id="changePassword"
        >
            CHANGE PASSWORD
        </button>

        <p id="resetMessage"></p>

    </div>

</div>


<!-- ================= MAIN WEBSITE ================= -->

