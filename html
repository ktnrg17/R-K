
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090909">
  <title>For You, Always ❤️</title>
  <link rel="stylesheet" href="style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,500&display=swap" rel="stylesheet">
</head>
<body>

  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>

  <header class="navbar">
    <a href="#home" class="logo"><span>♥</span> OUR LITTLE UNIVERSE</a>
    <nav>
      <a href="#home">Home</a>
      <a href="#letters">Letters</a>
      <a href="#memories">Memories</a>
    </nav>
    <a href="#letters" class="nav-heart" aria-label="Love letters">♥</a>
  </header>

  <main>
    <section id="home" class="hero">
      <div class="hero-content reveal">
        <p class="eyebrow">A LITTLE PLACE MADE FOR YOU</p>
        <h1>For You,<br><em>Always.</em></h1>
        <p class="hero-description">
          For every day you miss me, every moment you need a smile,
          and every time you need a reminder of how loved you are.
        </p>
        <a href="#letters" class="button">Enter our little world <span>→</span></a>
        <p class="signature">Made with love, just for you. ♥</p>
      </div>
      <div class="hero-glow"></div>
    </section>

    <section id="letters" class="section reveal">
      <div class="section-heading">
        <div>
          <p class="eyebrow">WORDS FROM MY HEART</p>
          <h2>Love Letters<span>.</span></h2>
          <p class="muted">Little pieces of my heart, saved just for you.</p>
        </div>
        <span class="counter" id="letter-count">03 LETTERS</span>
      </div>

      <div class="letter-grid">
        <button class="letter-card" data-letter="first">
          <span class="card-icon">✉</span>
          <span class="card-number">01 / ALWAYS</span>
          <span class="card-title">A Letter for My Girl</span>
          <span class="card-description">For the person who makes ordinary days special.</span>
          <span class="card-footer">OPEN LETTER <span>↗</span></span>
        </button>

        <button class="letter-card" data-letter="miss">
          <span class="card-icon">♡</span>
          <span class="card-number">02 / WHENEVER</span>
          <span class="card-title">When You Miss Me</span>
          <span class="card-description">A little reminder that distance can't change my love.</span>
          <span class="card-footer">OPEN LETTER <span>↗</span></span>
        </button>

        <button class="letter-card" data-letter="thank">
          <span class="card-icon">✧</span>
          <span class="card-number">03 / GRATITUDE</span>
          <span class="card-title">Thank You, Love</span>
          <span class="card-description">For being you, and for being part of my life.</span>
          <span class="card-footer">OPEN LETTER <span>↗</span></span>
        </button>
      </div>
    </section>

    <section id="memories" class="section reveal">
      <div class="section-heading">
        <div>
          <p class="eyebrow">LITTLE MOMENTS, FOREVER</p>
          <h2>Our Memories<span>.</span></h2>
          <p class="muted">Every place feels different when I'm there with you.</p>
        </div>
      </div>

      <div class="memory-grid">
        <div class="memory-card">
          <div class="memory-placeholder">01</div>
          <h3>Our favorite day</h3>
          <p>Replace this with a memory you share.</p>
        </div>
        <div class="memory-card">
          <div class="memory-placeholder">02</div>
          <h3>A place with you</h3>
          <p>A simple moment I wish I could relive.</p>
        </div>
        <div class="memory-card">
          <div class="memory-placeholder">03</div>
          <h3>More to come</h3>
          <p>Our story is still being written.</p>
        </div>
      </div>
    </section>

    <section class="closing reveal">
      <span class="closing-heart">♥</span>
      <p class="eyebrow">IN EVERY VERSION OF TOMORROW</p>
      <h2>I'd still choose <em>you.</em></h2>
      <p class="muted">Today, tomorrow, and all the ordinary days in between.</p>
    </section>
  </main>

  <footer>
    <p>MADE WITH LOVE <span>♥</span> JUST FOR YOU</p>
  </footer>

  <!-- Letter reader -->
  <div class="modal" id="letter-modal" aria-hidden="true">
    <div class="modal-backdrop" data-close></div>
    <article class="letter-paper" role="dialog" aria-modal="true"
      aria-labelledby="modal-title">
      <button class="close-button" data-close aria-label="Close letter">×</button>
      <p class="eyebrow">A MESSAGE FROM MY HEART</p>
      <h2 id="modal-title">My love,</h2>
      <div id="modal-body" class="letter-body"></div>
      <p class="letter-signature">Forever yours, <span>♥</span></p>
    </article>
  </div>

  <script src="script.js"></script>
</body>
</html>
